{
  "name": "yuragoo-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-19",
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      // Task 22: one deployment-wide budget/registry DO ("control-v1").
      { "name": "CONTROL_PLANE", "class_name": "ControlPlane" }
    ]
  },
  // Task 25: Workers AI binding for the one-shot normal-LLM calls
  // (@cf/qwen/qwen3-30b-a3b-fp8). It lives ONLY under env.production:
  // a top-level `ai` binding makes `wrangler dev` and vitest-pool-workers
  // open a paid remote-proxy session (Workers AI cannot run locally),
  // which breaks offline dev/test. Production deploys use
  // `wrangler deploy --env production` and receive env.AI; local/test
  // resolve the mock provider or GENERATION_UPSTREAM_URL instead.
  "env": {
    // Task 36: env-scoped assets — top-level config serves the API only
    // (wrangler dev / vitest-pool-workers stay asset-free). Production
    // and staging serve the SPA from Workers Static Assets on the same
    // worker: /api/* runs the worker first (Hono API + DO WS upgrade),
    // every other path falls to assets, and misses fall back to
    // index.html so client routes (/r/<id>) resolve in the browser.
    // Discord maps "/" and "/api" to this one origin, matching this.
    "production": {
      "name": "yuragoo-server",
      "ai": { "binding": "AI" },
      // env blocks never inherit durable_objects/migrations from the top
      // level — each deployable env restates both bindings and its tags.
      "durable_objects": {
        "bindings": [
          { "name": "GAME_ROOM", "class_name": "GameRoom" },
          { "name": "CONTROL_PLANE", "class_name": "ControlPlane" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
        { "tag": "v2", "new_sqlite_classes": ["ControlPlane"] }
      ],
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      }
    },
    "staging": {
      "name": "yuragoo-staging",
      "ai": { "binding": "AI" },
      "vars": {
        "APP_ENV": "production",
        "ALLOWED_ORIGINS": "https://yuragoo-staging.sasshinbun0655.workers.dev",
        "DISCORD_CLIENT_ID": "1553394215029968926",
        "DISCORD_ORIGINS": ".discordsays.com",
        "JEV_DAILY_ATTEMPT_CAP": "120",
        // Task 44 fix: unset -> parseCap fail-closed denied EVERY
        // generation reserve (choices/scenario/ending share the counter).
        "GENERATION_DAILY_ATTEMPTS": "60"
      },
      "durable_objects": {
        "bindings": [
          { "name": "GAME_ROOM", "class_name": "GameRoom" },
          { "name": "CONTROL_PLANE", "class_name": "ControlPlane" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
        { "tag": "v2", "new_sqlite_classes": ["ControlPlane"] }
      ],
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      }
    },
    // e2e-local: lets proxy.spec boot an assets-enabled worker without
    // touching the API-only dev config. Requires apps/web/dist to exist.
    "e2e": {
      "name": "yuragoo-e2e",
      "durable_objects": {
        "bindings": [
          { "name": "GAME_ROOM", "class_name": "GameRoom" },
          { "name": "CONTROL_PLANE", "class_name": "ControlPlane" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
        { "tag": "v2", "new_sqlite_classes": ["ControlPlane"] }
      ],
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      }
    }
  },
  // SQLite-backed DOs (ctx.storage.sql) — must be new_sqlite_classes, not
  // new_classes. v1 created GameRoom; v2 (Task 22) adds ControlPlane.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["ControlPlane"] }
  ]
}
